    "# Block 12\n",
    "# Calculate the time gap between consecutive admissions for each patient\n",
    "\n",
    "admissions_history = admissions_check.sort_values(\n",
    "    [\"patient_id\", \"admission_date\"]\n",
    ").copy()\n",
    "\n",
    "admissions_history[\"previous_discharge\"] = (\n",
