    "treatments = pd.read_csv(os.path.join(DATA_PATH, \"treatments.csv\"))\n",
    "\n",
    "datasets = {\n",
    "    \"Patients\": patients,\n",
    "    \"Admissions\": admissions,\n",
    "    \"Doctors\": doctors,\n",
    "    \"Vitals\": vitals,\n",
    "    \"Treatments\": treatments\n",
    "}\n",
    "\n",
    "for name, df in datasets.items():\n",
    "    print(f\"{name}: {df.shape[0]:,} rows × {df.shape[1]} columns\")"
   ]
