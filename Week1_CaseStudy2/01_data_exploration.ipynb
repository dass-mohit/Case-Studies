   "source": [
    "# Raw data folder\n",
    "RAW_PATH = \"../data/raw\"\n",
    "\n",
    "# File paths\n",
    "sales_file = os.path.join(RAW_PATH, \"sales.csv\")\n",
    "customers_file = os.path.join(RAW_PATH, \"customers.json\")\n",
    "products_file = os.path.join(RAW_PATH, \"products.csv\")\n",
    "\n",
    "# Load datasets\n",
    "sales = pd.read_csv(sales_file)\n",
    "customers = pd.read_json(customers_file)\n",
    "products = pd.read_csv(products_file)\n",
    "\n",
    "print(\"All datasets loaded successfully.\")"
   ]
  },
