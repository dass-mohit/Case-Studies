   "source": [
    "# DATA PROFILING - PART 1\n",
    "# Basic Structure & Data Types\n",
    "datasets = {\n",
    "    \"SALES\": sales,\n",
    "    \"CUSTOMERS\": customers,\n",
    "    \"PRODUCTS\": products\n",
    "}\n",
    "\n",
    "for name, df in datasets.items():\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(f\"{name} DATASET\")\n",
    "    print(\"=\" * 60)\n",
    "\n",
    "    print(\"\\nRows:\", df.shape[0])\n",
    "    print(\"Columns:\", df.shape[1])\n",
    "\n",
    "    print(\"\\nColumn Names:\")\n",
    "    print(df.columns.tolist())\n",
    "\n",
    "    print(\"\\nData Types:\")\n",
    "    print(df.dtypes)"
   ]
